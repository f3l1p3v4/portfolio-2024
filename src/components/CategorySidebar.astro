---
interface CategoryItem {
  id: string;
  name: string;
  count: number;
  type: 'category' | 'tag';
}

interface Props {
  categories: CategoryItem[];
  tags: CategoryItem[];
  totalPosts: number;
}

const { categories, tags, totalPosts } = Astro.props;
---

<aside class="w-full flex flex-col gap-8">
  {/* Seção Explore Categorias */}
  <div>
    <h2 class="text-xs font-mono uppercase tracking-wider text-text-2/70 mb-4 font-semibold flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-blue-accent"></span>
      Explore Categorias
    </h2>

    <div class="flex flex-wrap gap-2.5">
      {/* Botão Todos */}
      <button
        type="button"
        data-filter="all"
        class="category-pill active-pill group inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#0a0f18] border border-blue-accent/80 text-text-1 text-[11px] font-mono font-bold uppercase tracking-wider transition-all duration-200 cursor-pointer hover:border-blue-accent hover:scale-[1.02]"
      >
        <span class="w-2 h-2 rounded-full bg-blue-accent"></span>
        <span>Todos</span>
        <span class="text-[10px] text-text-2/70 pill-count font-normal">({totalPosts})</span>
      </button>

      {/* Lista de Categorias */}
      {categories.map((item) => (
        <button
          type="button"
          data-filter={item.id}
          class="category-pill group inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#0a0f18] border border-bg-2 text-text-2 hover:text-text-1 text-[11px] font-mono font-bold uppercase tracking-wider transition-all duration-200 cursor-pointer hover:border-blue-accent/60 hover:scale-[1.02]"
        >
          {/* Ícones em verde */}
          {item.id === 'inteligencia-artificial' && (
            <span class="w-4 h-4 rounded bg-blue-accent/15 text-blue-accent flex items-center justify-center text-[9px] font-black leading-none">
              IA
            </span>
          )}
          {item.id === 'frontend' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
          )}
          {item.id === 'backend' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
              <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
              <line x1="6" y1="6" x2="6.01" y2="6"></line>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
            </svg>
          )}
          {item.id === 'linux' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a5 5 0 00-5 5c0 1.5.7 3 2 4v4a3 3 0 00-3 3h12a3 3 0 00-3-3v-4c1.3-1 2-2.5 2-4a5 5 0 00-5-5z" />
            </svg>
          )}
          {item.id === 'redes' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          )}
          {item.id === 'ferramentas' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          )}
          {item.id === 'infraestrutura' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          )}

          <span>{item.name}</span>
          <span class="text-[10px] text-text-2/60 pill-count font-normal">({item.count})</span>
        </button>
      ))}
    </div>
  </div>

  {/* Seção Tags Populares */}
  <div>
    <h2 class="text-xs font-mono uppercase tracking-wider text-text-2/70 mb-4 font-semibold flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-blue-accent"></span>
      Tags & Tecnologias
    </h2>

    <div class="flex flex-wrap gap-2.5">
      {tags.map((tag) => (
        <button
          type="button"
          data-filter={tag.id}
          class="category-pill group inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#0a0f18] border border-bg-2 text-text-2 hover:text-text-1 text-[11px] font-mono font-bold uppercase tracking-wider transition-all duration-200 cursor-pointer hover:border-blue-accent/60 hover:scale-[1.02]"
        >
          {/* Todos os ícones em verde blue-accent */}
          {tag.id === 'reactjs' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
              <ellipse cx="12" cy="12" rx="10" ry="4"></ellipse>
              <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"></ellipse>
              <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"></ellipse>
            </svg>
          )}

          {tag.id === 'nodejs' && (
            <span class="w-4 h-4 rounded bg-blue-accent/15 text-blue-accent flex items-center justify-center text-[9px] font-bold">
              JS
            </span>
          )}

          {tag.id === 'javascript' && (
            <span class="w-4 h-4 rounded bg-blue-accent/15 text-blue-accent flex items-center justify-center text-[9px] font-black">
              JS
            </span>
          )}

          {tag.id === 'html' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="currentColor">
              <path d="M4 2l1.6 18 6.4 2 6.4-2L20 2H4zm13 5h-7.6l.2 2.5h7.2l-.6 6.5-4.2 1.2-4.2-1.2-.3-3.5h2.4l.1 1.7 2 .6 2-.6.2-2.7H6.9L6.4 5H17l-.2 2z"/>
            </svg>
          )}

          {tag.id === 'terminal' && (
            <span class="w-4 h-4 rounded bg-blue-accent/15 text-blue-accent flex items-center justify-center text-[9px] font-mono font-bold">
              &gt;_
            </span>
          )}

          {tag.id === 'zsh' && (
            <span class="w-4 h-4 rounded bg-blue-accent/15 text-blue-accent flex items-center justify-center text-[9px] font-mono font-bold">
              zsh
            </span>
          )}

          {tag.id === 'ia' && (
            <span class="w-4 h-4 rounded bg-blue-accent/15 text-blue-accent flex items-center justify-center text-[9px] font-black">
              IA
            </span>
          )}

          {tag.id === 'chatgpt' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14h2v2h-2v-2zm0-10h2v8h-2V6z"/>
            </svg>
          )}

          {tag.id === 'vscode' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.5 2.5L7 11.5l3.5 3L17.5 2.5zM2 9l3-2.5L8 9 5 11.5 2 9zm15.5 12.5l4.5-2V4.5l-4.5-2v19z"/>
            </svg>
          )}

          {tag.id === 'linux' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="currentColor">
              <circle cx="12" cy="12" r="8"></circle>
            </svg>
          )}

          {tag.id === 'redes' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="6" cy="6" r="3"></circle>
              <circle cx="18" cy="18" r="3"></circle>
              <line x1="8.5" y1="8.5" x2="15.5" y2="15.5"></line>
            </svg>
          )}

          {tag.id === 'google-hacking' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          )}

          {tag.id === 'dorks' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2L1 21h22L12 2zm0 3.5l8.5 14.5h-17L12 5.5z"/>
            </svg>
          )}

          {tag.id === 'hacking' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          )}

          {tag.id === 'netstat' && (
            <span class="w-4 h-4 rounded bg-blue-accent/15 text-blue-accent flex items-center justify-center text-[9px] font-mono">
              net
            </span>
          )}

          {tag.id === 'ciencia-da-computacao' && (
            <svg class="w-3.5 h-3.5 text-blue-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          )}

          <span>{tag.name}</span>
          <span class="text-[10px] text-text-2/60 pill-count font-normal">({tag.count})</span>
        </button>
      ))}
    </div>
  </div>
</aside>

<style>
  .active-pill {
    background-color: rgba(163, 234, 42, 0.12) !important;
    border-color: #a3ea2a !important;
    color: #ffffff !important;
    box-shadow: 0 0 12px rgba(163, 234, 42, 0.2);
  }

  .active-pill .pill-count {
    color: #a3ea2a !important;
  }
</style>
