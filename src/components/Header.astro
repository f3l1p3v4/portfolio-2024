---
const pathname = new URL(Astro.request.url).pathname;
import {
  FaHouse,
  FaPenToSquare,
  FaFlask,
  FaGraduationCap,
  FaBars,
  FaXmark,
} from "react-icons/fa6";

const navLinks = [
  { name: "Home", url: "/", icon: FaHouse },
  { name: "Blog", url: "/posts", icon: FaPenToSquare },
  { name: "Lab", url: "/lab", icon: FaFlask },
];
---

<header
  class="fixed top-0 left-0 right-0 z-[1000] bg-bg-1/80 backdrop-blur-md border-b border-bg-2 transition-all duration-300"
>
  <div
    class="max-w-[1200px] mx-auto px-6 py-4 flex items-center justify-between relative"
  >
    <!-- Logo -->
    <a
      href="/"
      class="flex items-center group no-underline z-50 select-none"
      aria-label="Felipe Valdez"
      title="Felipe Valdez"
    >
      <h1
        class="text-blue-accent text-2xl font-bold tracking-tight inline-flex items-center min-h-[2rem] whitespace-pre"
        aria-hidden="true"
      >
        <span id="header-logo-green">{"{"}F</span><span id="header-logo-white" class="text-white">V{"}"}</span><span id="header-logo-cursor" class="blinking-cursor text-blue-accent ml-[1px] font-mono hidden">|</span>
      </h1>
    </a>

    <!-- Navegação Desktop -->
    <nav class="hidden md:flex items-center gap-8 md:absolute md:left-1/2 md:-translate-x-1/2">
      {
        navLinks.map((link) => {
          const isActive =
            pathname === link.url ||
            (link.url !== "/" && pathname.startsWith(link.url));
          const Icon = link.icon;
          return (
            <a
              href={link.url}
              class={`text-sm font-medium transition-colors hover:text-blue-accent flex items-center gap-2 ${
                isActive ? "text-blue-accent" : "text-text-2"
              }`}
            >
              <Icon /> {link.name}
            </a>
          );
        })
      }
    </nav>

    <!-- Botão Contato (Let's Talk) -->
    <a
      onclick="const el = document.getElementById('contact'); if (el) { el.scrollIntoView({behavior:'smooth'}); } else { window.location.href = '/#contact'; }"
      class="hidden md:flex bg-blue-accent text-bg-1 font-bold text-sm px-5 py-2 rounded-full hover:opacity-80 transition-opacity no-underline cursor-pointer"
    >
      Entrar em Contato
    </a>

    <!-- Menu Mobile Toggle -->
    <div class="md:hidden flex items-center z-50">
      <button
        id="mobile-menu-btn"
        class="text-text-1 hover:text-blue-accent transition-colors p-2"
        aria-label="Abrir Menu"
      >
        <FaBars size={24} />
      </button>
    </div>
  </div>
</header>

<!-- Menu Mobile Overlay (fora do header para escapar do stacking context) -->
<div
  id="mobile-menu"
  class="fixed inset-0 bg-bg-1 z-[2000] translate-x-full transition-transform duration-300 flex flex-col items-center justify-center px-6 md:hidden"
>
  <button
    id="mobile-close-btn"
    class="absolute top-6 right-6 text-text-1 hover:text-blue-accent transition-colors p-2"
    aria-label="Fechar Menu"
  >
    <FaXmark size={32} />
  </button>

  <nav
    class="flex flex-col items-center justify-center gap-6 text-xl w-full max-w-xs"
  >
    {
      navLinks.map((link) => {
        const isActive =
          pathname === link.url ||
          (link.url !== "/" && pathname.startsWith(link.url));
        const Icon = link.icon;
        return (
          <a
            href={link.url}
            class={`font-medium transition-colors hover:text-blue-accent flex items-center gap-4 py-3 border-b border-bg-2/50 ${
              isActive ? "text-blue-accent" : "text-text-2"
            }`}
          >
            <Icon size={24} /> {link.name}
          </a>
        );
      })
    }
    <a
      onclick="document.getElementById('mobile-menu').classList.add('translate-x-full'); const el = document.getElementById('contact'); if (el) { el.scrollIntoView({behavior:'smooth'}); } else { window.location.href = '/#contact'; }"
      class="bg-blue-accent text-bg-1 font-bold text-center px-6 py-4 rounded-full mt-4 cursor-pointer"
    >
      Entrar em Contato
    </a>
  </nav>
</div>

<script>
  let currentAnimationId = 0;
  let typewriterTimeout: ReturnType<typeof setTimeout> | null = null;

  function runLogoTypewriter() {
    currentAnimationId++;
    const animationId = currentAnimationId;

    if (typewriterTimeout) {
      clearTimeout(typewriterTimeout);
      typewriterTimeout = null;
    }

    const greenEl = document.getElementById("header-logo-green");
    const whiteEl = document.getElementById("header-logo-white");
    const cursorEl = document.getElementById("header-logo-cursor");

    if (!greenEl || !whiteEl || !cursorEl) return;

    const fullName = "{Felipe Valdez}";
    const shortName = "{FV}";

    function render(text: string, isFullName: boolean) {
      if (!greenEl || !whiteEl) return;
      // For "{Felipe Valdez}", "{Felipe " is 8 chars (green), "Valdez}" is 7 chars (white)
      // For "{FV}", "{F" is 2 chars (green), "V}" is 2 chars (white)
      const splitIndex = isFullName ? 8 : 2;
      greenEl.textContent = text.slice(0, splitIndex);
      whiteEl.textContent = text.slice(splitIndex);
    }

    function wait(ms: number) {
      return new Promise<void>((resolve) => {
        typewriterTimeout = setTimeout(resolve, ms);
      });
    }

    // Initial state: static "{FV}" with no cursor
    render(shortName, false);
    cursorEl.classList.add("hidden");

    async function cycle() {
      if (animationId !== currentAnimationId) return;

      // Wait initially or between cycles with "{FV}" shown
      await wait(3500);
      if (animationId !== currentAnimationId) return;

      // Show cursor: "{FV}|"
      cursorEl.classList.remove("hidden");
      await wait(300);
      if (animationId !== currentAnimationId) return;

      // Erase "{FV}"
      let text = shortName;
      while (text.length > 0) {
        text = text.slice(0, -1);
        render(text, false);
        await wait(60);
        if (animationId !== currentAnimationId) return;
      }

      await wait(250);
      if (animationId !== currentAnimationId) return;

      // Type "{Felipe Valdez}"
      for (let i = 1; i <= fullName.length; i++) {
        render(fullName.slice(0, i), true);
        await wait(85);
        if (animationId !== currentAnimationId) return;
      }

      // Pause displaying "{Felipe Valdez}|"
      await wait(2200);
      if (animationId !== currentAnimationId) return;

      // Erase "{Felipe Valdez}"
      text = fullName;
      while (text.length > 0) {
        text = text.slice(0, -1);
        render(text, true);
        await wait(45);
        if (animationId !== currentAnimationId) return;
      }

      await wait(250);
      if (animationId !== currentAnimationId) return;

      // Type "{FV}"
      for (let i = 1; i <= shortName.length; i++) {
        render(shortName.slice(0, i), false);
        await wait(85);
        if (animationId !== currentAnimationId) return;
      }

      // Brief pause with cursor on "{FV}|"
      await wait(400);
      if (animationId !== currentAnimationId) return;

      // Hide cursor: "depois fica apenas {FV}"
      cursorEl.classList.add("hidden");

      // Stay as "{FV}" before repeating cycle
      await wait(6500);
      if (animationId !== currentAnimationId) return;

      cycle();
    }

    cycle();
  }

  document.addEventListener("astro:page-load", () => {
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const closeBtn = document.getElementById("mobile-close-btn");

    if (menuBtn && mobileMenu && closeBtn) {
      menuBtn.addEventListener("click", () => {
        mobileMenu.classList.remove("translate-x-full");
      });

      closeBtn.addEventListener("click", () => {
        mobileMenu.classList.add("translate-x-full");
      });
    }

    runLogoTypewriter();
  });

  document.addEventListener("astro:before-swap", () => {
    currentAnimationId++;
    if (typewriterTimeout) {
      clearTimeout(typewriterTimeout);
      typewriterTimeout = null;
    }
  });
</script>
