      <div class="w-full md:w-1/3 animate-on-scroll">
        <h2 class="text-[2.5rem] md:text-[3.5rem] font-bold text-text-1 leading-tight">Como eu <span class="text-blue-accent">trabalho.</span></h2>
        <p class="text-text-2 mt-6 text-xl leading-relaxed">Um fluxo otimizado para entregar o máximo de valor com eficiência e transparência.</p>
      </div>
      <div class="w-full md:w-2/3 process-timeline relative" id="process-timeline">
        {processSteps.map((step, idx) => (
          <div class={`process-step flex gap-8 relative opacity-0 translate-y-8 transition-all duration-700`} data-step={idx}>
            <div class="flex-shrink-0 w-12 h-12 rounded-full bg-blue-accent/10 border-2 border-blue-accent flex items-center justify-center text-blue-accent font-black text-2xl shadow-[0_0_25px_rgba(163,234,42,0.6)] z-10">
              {idx + 1}
            </div>
            <div class="pb-16">
              <h3 class="text-2xl font-bold text-text-1 mb-4">{step.title}</h3>
              <p class="text-text-2 text-sm md:text-[1.2rem] leading-relaxed">{step.desc}</p>
            </div>
            {idx < processSteps.length - 1 && (
              <>
                <div class="absolute left-6 top-12 w-0.5 h-[calc(100%-3rem)] bg-text-2/20 -translate-x-1/2 z-0"></div>
                <div class="process-line absolute left-6 top-12 w-0.5 bg-blue-accent shadow-[0_0_20px_rgba(163,234,42,0.8)] -translate-x-1/2 z-10 flex flex-col justify-end items-center" data-line={idx}>
                  <div class="process-dot w-2 h-2 rounded-full bg-blue-accent shadow-[0_0_15px_4px_rgba(163,234,42,1)] translate-y-1/2"></div>
                </div>
              </>
            )}
          </div>
        ))}
      </div>
    </div>
