<script is:inline>
  function showFormAlert(message) {
    const alertEl = document.getElementById('form-alert');
    const alertText = document.getElementById('form-alert-text');
    alertText.textContent = message;
    alertEl.classList.remove('hidden');
    alertEl.style.animation = 'none';
    alertEl.offsetHeight;
    alertEl.style.animation = '';
  }

  function hideFormAlert() {
    const alertEl = document.getElementById('form-alert');
    alertEl.classList.add('hidden');
  }

  function sendWhatsApp() {
    const nome = document.getElementById('w-nome').value;
    const servico = document.getElementById('w-servico').value;
    const mensagem = document.getElementById('w-mensagem').value;
    
    hideFormAlert();
    
    if (!nome || !servico) {
      showFormAlert("Por favor, preencha pelo menos seu nome e o serviço desejado.");
      return;
    }
    
    const text = `Olá, meu nome é *${nome}*.\nTenho interesse no serviço: *${servico}*.\n\n${mensagem}`;
    const encodedText = encodeURIComponent(text);
    window.open(`https://wa.me/5567992656801?text=${encodedText}`, '_blank');
  }

  function initCustomSelect() {
    const trigger = document.getElementById('custom-select-trigger');
    const dropdown = document.getElementById('custom-select-dropdown');
    const chevron = document.getElementById('custom-select-chevron');
    const hiddenInput = document.getElementById('w-servico');
    const label = document.getElementById('custom-select-label');
    const iconContainer = document.getElementById('custom-select-icon-container');
    const options = document.querySelectorAll('.custom-select-option');

    if (!trigger || !dropdown) return;

    function openDropdown() {
      dropdown.classList.remove('hidden');
      chevron?.classList.add('rotate-180');
      trigger.classList.add('border-blue-accent');
      trigger.setAttribute('aria-expanded', 'true');
    }

    function closeDropdown() {
      dropdown.classList.add('hidden');
      chevron?.classList.remove('rotate-180');
      trigger.classList.remove('border-blue-accent');
      trigger.setAttribute('aria-expanded', 'false');
    }

    trigger.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (dropdown.classList.contains('hidden')) {
        openDropdown();
      } else {
        closeDropdown();
      }
    };

    options.forEach(opt => {
      opt.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const value = opt.getAttribute('data-value') || '';
        const labelText = opt.getAttribute('data-label') || '';
        const iconElement = opt.querySelector('.option-icon');

        if (hiddenInput) hiddenInput.value = value;
        if (label) {
          label.textContent = labelText;
          label.classList.remove('text-text-2');
          label.classList.add('text-text-1', 'font-medium');
        }

        if (iconElement && iconContainer) {
          iconContainer.innerHTML = iconElement.innerHTML;
          iconContainer.classList.remove('text-text-2');
          iconContainer.classList.add('text-blue-accent');
        }

        options.forEach(o => {
          const check = o.querySelector('.check-mark');
          if (o === opt) {
            check?.classList.remove('hidden');
            o.classList.add('bg-bg-2/80');
          } else {
            check?.classList.add('hidden');
            o.classList.remove('bg-bg-2/80');
          }
        });

        hideFormAlert();
        closeDropdown();
      };
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target) && !trigger.contains(e.target)) {
        closeDropdown();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDropdown();
      }
    });
  }

  initCustomSelect();
  document.addEventListener('astro:page-load', initCustomSelect);
</script>
